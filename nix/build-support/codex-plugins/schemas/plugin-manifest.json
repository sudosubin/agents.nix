{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/codex-plugin-manifest.json",
  "$comment": "Matches the legacy manifest parser in openai/codex rust-v0.160.0, codex-rs/core-plugins/src/manifest.rs. Unknown metadata is ignored; optional fields accept null.",
  "title": "Codex plugin manifest",
  "description": "Manifest for an OpenAI Codex plugin.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin identifier.",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional plugin version."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Brief plugin description."
    },
    "skills": {
      "description": "Invalid declarations are ignored by Codex with a warning."
    },
    "apps": {
      "type": [
        "string",
        "null"
      ]
    },
    "mcpServers": {
      "description": "Relative path to an MCP manifest or inline MCP server configuration.",
      "oneOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "interface": {
      "oneOf": [
        {
          "$ref": "#/definitions/pluginInterface"
        },
        {
          "type": "null"
        }
      ]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "httpsUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "relativePath": {
      "type": "string"
    },
    "assetPath": {
      "type": [
        "string",
        "null"
      ],
      "description": "Package-relative asset path."
    },
    "defaultPrompt": {
      "description": "Starter prompt shown by Codex clients.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "pluginInterface": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "shortDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "longDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "developerName": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "websiteURL": {
          "$ref": "#/definitions/httpsUrl"
        },
        "privacyPolicyURL": {
          "$ref": "#/definitions/httpsUrl"
        },
        "termsOfServiceURL": {
          "$ref": "#/definitions/httpsUrl"
        },
        "defaultPrompt": {
          "$ref": "#/definitions/defaultPrompt"
        },
        "default_prompt": {
          "$ref": "#/definitions/defaultPrompt"
        },
        "brandColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "composerIcon": {
          "$ref": "#/definitions/assetPath"
        },
        "logo": {
          "$ref": "#/definitions/assetPath"
        },
        "logoDark": {
          "$ref": "#/definitions/assetPath",
          "description": "Optional package-relative logo asset used in dark mode."
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
